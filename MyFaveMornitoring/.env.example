# Grafana 관리자 비밀번호
GRAFANA_PASSWORD=your-grafana-password

# 프로덕션 서버 도메인 또는 IP (k6 부하테스트 대상)
PROD_HOST=your-production-domain

# PostgreSQL 연결 DSN (postgres_exporter용)
# 비밀번호에 특수문자 포함 시 URL 인코딩 필요: + → %2B, / → %2F
POSTGRES_EXPORTER_DSN=postgresql://username:url-encoded-password@host:5432/dbname?sslmode=disable
